{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "Feature coverage",
    "summary": "Exercises every modeled 3.1 addition",
    "version": "1.0.0",
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "webhooks": {
    "newPet": {
      "post": {
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
        },
        "responses": { "200": { "description": "ok" } }
      }
    },
    "reusedHook": { "$ref": "#/components/pathItems/PingHook" }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": ["object", "null"],
        "properties": {
          "id": { "type": "number", "exclusiveMinimum": 0.0, "exclusiveMaximum": 1.0E9 },
          "name": { "type": "string", "contentEncoding": "utf-8", "contentMediaType": "text/plain" },
          "thumb": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png", "contentSchema": { "type": "string" } },
          "kind": { "const": "cat" },
          "tail": { "type": ["string", "null"] },
          "coords": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }] }
        },
        "dependentRequired": { "thumb": ["name"] },
        "dependentSchemas": { "thumb": { "required": ["name"] } },
        "unevaluatedProperties": false,
        "unevaluatedItems": { "type": "string" },
        "$defs": { "Id": { "type": "number" } }
      }
    },
    "pathItems": {
      "PingHook": {
        "post": { "responses": { "200": { "description": "ok" } } }
      }
    }
  }
}
